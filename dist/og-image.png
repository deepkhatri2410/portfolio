<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#050810"/>
      <stop offset="100%" stop-color="#080d1a"/>
    </linearGradient>
    <linearGradient id="grad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#7c3aed"/>
      <stop offset="100%" stop-color="#06b6d4"/>
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="8" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>
  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bg)"/>
  <!-- Grid lines -->
  <g opacity="0.04" stroke="#7c3aed" stroke-width="1">
    <line x1="0" y1="60" x2="1200" y2="60"/><line x1="0" y1="120" x2="1200" y2="120"/>
    <line x1="0" y1="180" x2="1200" y2="180"/><line x1="0" y1="240" x2="1200" y2="240"/>
    <line x1="0" y1="300" x2="1200" y2="300"/><line x1="0" y1="360" x2="1200" y2="360"/>
    <line x1="0" y1="420" x2="1200" y2="420"/><line x1="0" y1="480" x2="1200" y2="480"/>
    <line x1="0" y1="540" x2="1200" y2="540"/>
    <line x1="60" y1="0" x2="60" y2="630"/><line x1="120" y1="0" x2="120" y2="630"/>
    <line x1="180" y1="0" x2="180" y2="630"/><line x1="240" y1="0" x2="240" y2="630"/>
    <line x1="300" y1="0" x2="300" y2="630"/><line x1="360" y1="0" x2="360" y2="630"/>
    <line x1="420" y1="0" x2="420" y2="630"/><line x1="480" y1="0" x2="480" y2="630"/>
    <line x1="540" y1="0" x2="540" y2="630"/><line x1="600" y1="0" x2="600" y2="630"/>
    <line x1="660" y1="0" x2="660" y2="630"/><line x1="720" y1="0" x2="720" y2="630"/>
    <line x1="780" y1="0" x2="780" y2="630"/><line x1="840" y1="0" x2="840" y2="630"/>
    <line x1="900" y1="0" x2="900" y2="630"/><line x1="960" y1="0" x2="960" y2="630"/>
    <line x1="1020" y1="0" x2="1020" y2="630"/><line x1="1080" y1="0" x2="1080" y2="630"/>
    <line x1="1140" y1="0" x2="1140" y2="630"/>
  </g>
  <!-- Orb top right -->
  <circle cx="950" cy="130" r="220" fill="rgba(124,58,237,0.15)" filter="url(#glow)"/>
  <!-- Orb bottom left -->
  <circle cx="200" cy="520" r="160" fill="rgba(6,182,212,0.1)" filter="url(#glow)"/>
  <!-- DK monogram badge -->
  <rect x="80" y="80" width="72" height="72" rx="16" fill="url(#grad)"/>
  <text x="116" y="130" font-family="monospace" font-size="28" font-weight="bold" fill="white" text-anchor="middle">DK</text>
  <!-- Name -->
  <text x="80" y="230" font-family="'Space Grotesk', sans-serif" font-size="60" font-weight="700" fill="#f1f5f9" letter-spacing="-1">Deep Khatri</text>
  <!-- Role -->
  <text x="80" y="285" font-family="monospace" font-size="16" fill="#06b6d4" letter-spacing="3">COMPUTER ENGINEERING STUDENT · DEVELOPER · BUILDER</text>
  <!-- Divider -->
  <line x1="80" y1="315" x2="700" y2="315" stroke="url(#grad)" stroke-width="2"/>
  <!-- Tagline -->
  <text x="80" y="360" font-family="'Space Grotesk', sans-serif" font-size="28" fill="#94a3b8">Building Ideas Into</text>
  <text x="80" y="400" font-family="'Space Grotesk', sans-serif" font-size="28" font-weight="700" fill="url(#grad)">Intelligent Experiences.</text>
  <!-- Badges -->
  <rect x="80" y="440" width="120" height="32" rx="16" fill="rgba(124,58,237,0.2)" stroke="rgba(124,58,237,0.4)" stroke-width="1"/>
  <text x="140" y="461" font-family="monospace" font-size="12" fill="#a855f7" text-anchor="middle">AWS Amplify</text>
  <rect x="212" y="440" width="110" height="32" rx="16" fill="rgba(6,182,212,0.15)" stroke="rgba(6,182,212,0.3)" stroke-width="1"/>
  <text x="267" y="461" font-family="monospace" font-size="12" fill="#06b6d4" text-anchor="middle">React + TS</text>
  <rect x="334" y="440" width="130" height="32" rx="16" fill="rgba(59,130,246,0.15)" stroke="rgba(59,130,246,0.3)" stroke-width="1"/>
  <text x="399" y="461" font-family="monospace" font-size="12" fill="#3b82f6" text-anchor="middle">DEEP.OS Terminal</text>
  <!-- GitHub -->
  <text x="80" y="530" font-family="monospace" font-size="14" fill="#475569">github.com/deepkhatri2410 · linkedin.com/in/deep-khatri-964306417</text>
  <!-- AWS Builder Badge -->
  <rect x="960" y="460" width="200" height="100" rx="12" fill="rgba(245,158,11,0.08)" stroke="rgba(245,158,11,0.3)" stroke-width="1"/>
  <text x="1060" y="502" font-family="monospace" font-size="11" fill="#f59e0b" text-anchor="middle">AWS STUDENT</text>
  <text x="1060" y="520" font-family="monospace" font-size="11" fill="#f59e0b" text-anchor="middle">BUILDER CHALLENGE</text>
  <text x="1060" y="541" font-family="'Space Grotesk', sans-serif" font-size="20" font-weight="700" fill="#f59e0b" text-anchor="middle">2026</text>
</svg>

